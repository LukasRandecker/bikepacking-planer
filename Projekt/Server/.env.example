# Vorlage für Server/.env — diese Datei kopieren und die Werte eintragen.
# Die echte .env ist gitignored und gehört nie ins Repository.

# Pflicht. Verbindung zur MongoDB. Die Datenbank heißt fest "bikepacking";
# sie muss in der URI nicht stehen.
#   lokal:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<passwort>@<cluster>.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017

# Pflicht, mindestens 16 Zeichen. Signiert die Sitzungs-Token — ohne diesen
# Wert startet der Server absichtlich nicht. Eine zufällige Zeichenkette
# erzeugen, z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=hier-ein-langes-zufaelliges-geheimnis-eintragen

# Optional. Port des Servers, Standard 3030.
PORT=3030

# Optional. Wer den Server ansprechen darf, kommagetrennt. Ohne die Variable
# gelten http://localhost:5173 (Dev) und http://localhost:4173 (Preview).
# Beim Deployment gehört hier die echte Frontend-Adresse hinein.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Optional, aber beim Deployment Pflicht: setzt das `secure`-Flag auf dem
# Sitzungs-Cookie, sodass es nur über HTTPS übertragen wird. Lokal bleibt es
# aus, weil die App über http läuft.
COOKIE_SECURE=false
