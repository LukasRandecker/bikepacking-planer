# Adresse des Express-Servers. Ohne diese Variable nimmt src/lib/api.js
# http://localhost:3030 an — das reicht für die lokale Entwicklung.
# Für einen anderen Host: diese Datei nach .env.local kopieren und anpassen.
# Im Demo-Modus (siehe unten) wird sie nicht gelesen.
VITE_API_URL=http://localhost:3030

# Adresse, unter der die Seite selbst erreichbar ist. Sie landet in canonical,
# og:url, robots.txt und sitemap.xml (siehe vite.config.js). Ohne die Variable
# gilt http://localhost:4173 — so steht keine erfundene Domain in den
# Metadaten, solange nichts deployt ist.
VITE_SITE_URL=http://localhost:4173

# ---------------------------------------------------------------------------
# Demo-Modus: die App ohne Server
# ---------------------------------------------------------------------------
#
# `true` heißt: es wird kein einziger Netzwerkaufruf an eine API abgesetzt.
# Statt eines HTTP-Requests beantwortet ein eigener Axios-Adapter jeden Aufruf
# im Browser (src/lib/api.local.js). Was ohne Server geht, geht dann wirklich:
# GPX lesen und rechnen, Karte, Katalogsuche über die 500 Einträge, Packliste
# mit Gewichts- und Preissumme, PDF-Export. Was einen Server braucht — Konten,
# Speichern, Veröffentlichen, Bild-Upload — ist in der Oberfläche nicht
# vorhanden, nicht bloß ausgegraut.
#
# Zwei Fälle:
#
#   VITE_DEMO=false   Normalbetrieb. Die App spricht mit dem Express-Server
#                     unter VITE_API_URL. Das ist die Voreinstellung: fehlt
#                     die Variable, läuft die App gegen den echten Server.
#                     So wird lokal entwickelt (npm run dev + Server auf 3030).
#
#   VITE_DEMO=true    Öffentliche Demo ohne Backend, z. B. auf Cloudflare
#                     Pages. VITE_API_URL wird ignoriert. Der Demo-Streifen
#                     unter der Navigation sagt Besuchern, was sie vor sich
#                     haben, und verlinkt Server-Code und OpenAPI-Beschreibung.
#
# Das ist die Variable, die den Server später zurückholt: steht die API unter
# einer echten Adresse, wird hier auf false gestellt und VITE_API_URL gesetzt.
# Am Code ändert sich dafür nichts.
VITE_DEMO=false
